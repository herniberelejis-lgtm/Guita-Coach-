# ── Base de datos ───────────────────────────────────────────────────
# Desarrollo: SQLite local. Producción: Postgres (Railway lo provee con un click).
DATABASE_URL="file:./dev.db"

# ── Requerido siempre ──────────────────────────────────────────────
# Generá un valor aleatorio fuerte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se usa para firmar sesiones y cifrar tokens OAuth guardados en la base.
SECRET_KEY=

# ── IA (clasificación y chat) ───────────────────────────────────────
AI_PROVIDER=gemini
# Obtener en: aistudio.google.com/apikey
GEMINI_API_KEY=
# Obtener en: console.anthropic.com → API Keys
CLAUDE_API_KEY=

# ── Gmail OAuth ─────────────────────────────────────────────────────
# Obtener en: console.cloud.google.com
# 1. Crear proyecto → Habilitar Gmail API
# 2. Credenciales → OAuth 2.0 → Web → redirect: {APP_URL}/api/auth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Mercado Pago OAuth ───────────────────────────────────────────────
# Obtener en: developers.mercadopago.com → Tu aplicación
# Redirect URI: {APP_URL}/api/auth/mp/callback
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# ── Plaid (opcional, agregadores bancarios EE.UU./intl) ─────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── Prometeo (Open Banking Argentina, opcional) ──────────────────────
PROMETEO_API_KEY=
PROMETEO_ENV=sandbox

# ── Config de la app ────────────────────────────────────────────────
# URL pública por la que se accede a la app (la sirve el gateway).
APP_URL=http://localhost:8000
DEMO_MODE=false
LIVE_PRICES=true

# ── Microservicios: puertos ─────────────────────────────────────────
# El gateway es el único puerto expuesto públicamente; el resto son
# internos (en Docker se resuelven por nombre de servicio, no por puerto).
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=4001
TRANSACTIONS_SERVICE_PORT=4002
BUDGET_SERVICE_PORT=4003
INVESTMENTS_SERVICE_PORT=4004
AI_SERVICE_PORT=4005

# ── Microservicios: URLs (a dónde le pega el gateway) ───────────────
# En desarrollo local (localhost) los defaults ya funcionan.
# En docker-compose se sobreescriben con los nombres de los servicios.
AUTH_SERVICE_URL=http://localhost:4001
TRANSACTIONS_SERVICE_URL=http://localhost:4002
BUDGET_SERVICE_URL=http://localhost:4003
INVESTMENTS_SERVICE_URL=http://localhost:4004
AI_SERVICE_URL=http://localhost:4005
